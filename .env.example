# Inbound email webhook secret
# Local demo: leave empty (open POST /api/inbound).
# Production: REQUIRED — generate with: openssl rand -hex 32
# When set, unsigned POST /api/inbound is rejected (401) unless the request
# sends Authorization: Bearer <secret>, header X-Inbound-Secret, or ?secret=
INBOUND_WEBHOOK_SECRET=

# mailgun | sendgrid | dev
# Hint for field naming; parser accepts both styles either way.
# "dev" keeps POST /api/inbound/dev enabled in production builds.
# Use "mailgun" on a public deploy with a real Mailgun receiving route.
MAIL_PROVIDER=dev

# Force-enable /api/inbound/dev even when MAIL_PROVIDER is mailgun|sendgrid in production
# ALLOW_INBOUND_DEV=1

# Optional: Vercel Blob read/write token (auto-set when you create a Blob store
# on the Vercel project). When set, inbox persists to blob pathname
# inbox/bay-studies-inbox.json instead of ephemeral /tmp on Vercel.
# Soft-launch works without it; mail can vanish on cold starts.
# BLOB_READ_WRITE_TOKEN=

# Same token also persists approved studies to blob pathname
# inbox/bay-studies-published.json (Approve → feed survives localStorage clears).
# Without Blob on Vercel: /tmp/bay-studies-published.json (ephemeral).
# Locally: data/published.json

# Admin UI gate for /admin/* (ingest, firms, setup) AND mutating APIs
# (POST/PATCH/DELETE /api/published, POST /api/inbox/reparse).
# Local demo: leave empty — pages + writes stay open with an amber warning banner.
# Production: REQUIRED — generate with: openssl rand -hex 32
# When set, middleware redirects to /admin/login unless the request has a valid
# cookie (bay_studies_admin), Authorization: Bearer, X-Admin-Secret header,
# or ?admin_secret= / ?secret= (query sets the cookie and redirects clean).
# GET /api/published, GET /api/inbox stay public; POST /api/inbound uses
# INBOUND_WEBHOOK_SECRET (not this admin secret).
# POST /api/inbox/import (Craigslist etc drafts) uses this admin secret.
ADMIN_SECRET=

# Public feed (production): only human-approved studies from /api/published.
# Seeds/demos are never merged in, even when the published list is empty.
# Local `next dev`: seeds show only while nothing is published yet.
# Set to 1 to also allow that empty-list fallback outside production
# (client feed reads NEXT_PUBLIC_SHOW_SEED_STUDIES).
# NEXT_PUBLIC_SHOW_SEED_STUDIES=
# SHOW_SEED_STUDIES=
