# Inbound email webhook secret
# Local demo: leave empty (open POST /api/inbound).
# Production: REQUIRED — generate with: openssl rand -hex 32
# When set, unsigned POST /api/inbound is rejected (401) unless the request
# sends Authorization: Bearer <secret>, header X-Inbound-Secret, or ?secret=
INBOUND_WEBHOOK_SECRET=

# mailgun | sendgrid | dev
# Hint for field naming; parser accepts both styles either way.
# "dev" keeps POST /api/inbound/dev enabled in production builds.
# Use "mailgun" on a public deploy with a real Mailgun receiving route.
MAIL_PROVIDER=dev

# Force-enable /api/inbound/dev even when MAIL_PROVIDER is mailgun|sendgrid in production
# ALLOW_INBOUND_DEV=1
